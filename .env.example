# Telegram bot that receives contact-form submissions.
# Create a bot with @BotFather, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# The chat that should receive the notification.
# Message your bot once, then open:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and copy result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Sentry DSN for the serverless function. Optional in local dev.
# Leave empty and error reporting is skipped without crashing.
SENTRY_DSN=

# Set automatically by Vercel. Used to tag Sentry events.
# VERCEL_ENV=development
